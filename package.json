    "echarts",
    "datatable"
  ],
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "codemirror": "^5.65.0",
    "echarts": "^5.5.0",
    "leaflet": "^1.9.4",
    "lucide": "^1.25.0",
    "quill": "^2.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
